# Copy to .env for local development. Never commit .env. Example values only.

# SQL Server container (compose.yaml). Min 8 chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Change-Me-Local-1!

# ASP.NET Core API (apps/api). Use the same password as above.
ConnectionStrings__Lingozi="Server=localhost,1433;Database=Lingozi;User Id=sa;Password=Change-Me-Local-1!;TrustServerCertificate=true;Encrypt=true"
ASPNETCORE_ENVIRONMENT=Development

# Next.js server -> API origin (apps/web). The browser never calls this directly.
API_ORIGIN=http://localhost:5080

# Sign-in codes (US-AUTH-01). Generate your own key: openssl rand -base64 32 (never reuse an example value).
Auth__LoginCodeHmacKey=REPLACE-WITH-OUTPUT-OF-openssl-rand-base64-32
# Per-IP limits (defaults: 10 code requests and 20 code checks per 10 minutes). Raise them only for E2E runs.
# Auth__RequestCodePerIpPer10Minutes=1000
# Auth__VerifyCodePerIpPer10Minutes=1000

# Email delivery. Local: Mailpit from compose.yaml (UI http://localhost:8025). Without Email__SmtpHost, mails stay Pending.
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__SmtpUseTls=false


# Development defaults to scandict. Set none to disable; production defaults to none.
# Pronunciation__Provider=scandict
